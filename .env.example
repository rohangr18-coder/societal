# GEMINI_API_KEY: Required for server-side Gemini AI features (Mithra AI Chatbot, smart suggestions).
# In Google AI Studio: Injected automatically via runtime secrets.
# In Vercel: Set under Project Settings > Environment Variables as GEMINI_API_KEY.
# CRITICAL: Keep server-side only. Never expose as VITE_ variable.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: Base URL of the deployed application.
APP_URL="https://your-app-domain.vercel.app"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform interactive maps and GPS geocoding.
# Must be configured in Google Cloud Console with Maps JavaScript API enabled.
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Firebase Client Configuration:
# (Optional on Vercel: if omitted, the app automatically falls back to firebase-applet-config.json)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="your-firestore-database-id"
